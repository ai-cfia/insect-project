# Flask Configuration
SECRET_KEY=your-secret-key-here

# GitHub Configuration
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=ai-cfia/insect-project

# Initial email list (JSON array) - will be filtered to @inspection.gc.ca only
INITIAL_EMAILS_LIST=["test.test@inspection.gc.ca","test.test2@inspection.gc.ca","test.test3@inspection.gc.ca","test.test4@inspection.gc.ca","test.test4@inspection.gc.ca"]

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Configuration (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@inspection.gc.ca
